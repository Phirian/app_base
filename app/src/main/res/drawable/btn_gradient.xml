<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#56ab2f" android:endColor="#a8e063" android:angle="90"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#43cea2" android:endColor="#185a9d" android:angle="90"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>